# 이 파일을 .env 로 복사한 뒤 값만 채운다. .env 는 커밋하지 않는다.
# KOBIS 오픈API 키 (https://www.kobis.or.kr/kobisopenapi/)
KOBIS_API_KEY=
# 카카오 REST API 키 (https://developers.kakao.com/ → 내 애플리케이션 → 앱 키)
KAKAO_REST_API_KEY=
# TMDB API 키 v3 (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# SSAFY GMS 키 (https://gms.ssafy.io/web/)
GMS_KEY=
GMS_MODEL=gpt-5.4-nano
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
# 실행 설정
REPLAN_LIMIT=3
AD_MINUTES=10
